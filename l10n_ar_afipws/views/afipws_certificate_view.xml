<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afipws_certificate_form" model="ir.ui.view">
        <field name="name">afipws.certificate.form</field>
        <field name="model">afipws.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificados ARCA">
                <header>
                    <button name="%(action_upload_certificate)d"
                        type="action"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                        string="Cargar certificado"/>
                    <button name="action_confirm"
                        type="object"
                        invisible="state != 'draft'"
                        string="Confirmar"/>
                    <button name="action_to_draft"
                        type="object"
                        invisible="state != 'cancel'"
                        string="To Draft"/>
                    <button name="action_cancel"
                        type="object"
                        invisible="state not in ('draft', 'confirmed')"
                        string="Cancel"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet string="Certificados ARCA">
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Descargá la solicitud <b>.csr</b> y subila al portal ARCA para obtener el
                        certificado firmado. La clave privada ya está guardada en Odoo.
                        Luego usá <b>Cargar certificado</b> para adjuntar el archivo <b>.crt</b>.
                    </div>
                    <group>
                        <field name="alias_id" readonly="state != 'draft'"/>
                        <field name="csr" groups="base.group_no_one" readonly="state != 'draft'"/>
                        <field name="request_filename" invisible="1"/>
                        <field name="request_file" string="Solicitud de certificado (.csr)" readonly="state != 'draft'" filename="request_filename"/>
                        <field name="crt" groups="base.group_no_one" readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_afipws_certificate_tree" model="ir.ui.view">
        <field name="name">afipws.certificate.list</field>
        <field name="model">afipws.certificate</field>
        <field name="arch" type="xml">
            <list string="Certificados ARCA">
                <field name="alias_id"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>
